# Public site URL used to construct absolute URLs (optional)
REACT_APP_SITE_URL=https://your-domain.com

# Social links (optional)
REACT_APP_GITHUB_URL=https://github.com/your-username
REACT_APP_LINKEDIN_URL=https://www.linkedin.com/in/your-username
REACT_APP_TWITTER_URL=https://twitter.com/your-username

# Resume direct URL (optional). If not set, app attempts to use <SITE_URL>/resume.pdf
REACT_APP_RESUME_URL=https://your-domain.com/resume.pdf
